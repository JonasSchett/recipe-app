// Prisma schema for the Recipe Management App.
// Includes Auth.js (NextAuth) models plus the application domain models.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum Visibility {
  PRIVATE
  PUBLIC
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) models — required by @auth/prisma-adapter.
// ---------------------------------------------------------------------------

model User {
  id            String           @id @default(cuid())
  name          String?
  email         String?          @unique
  emailVerified DateTime?
  image         String?
  role          Role             @default(USER)
  accounts      Account[]
  sessions      Session[]
  recipes       Recipe[]
  heartedTags   UserHeartedTag[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // --- Per-user settings (see /account) -------------------------------------
  // Kept as columns rather than a separate settings table: database sessions
  // already hand the session callback the full user row, so a new column costs
  // no extra query and has no "settings row missing" case to handle.

  /// Pre-selects the visibility on the create-recipe form. A form default only
  /// — the schema default below and the Zod default both stay PRIVATE, so a
  /// payload that omits visibility can never publish by accident.
  defaultRecipeVisibility Visibility @default(PRIVATE)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Application domain models.
// ---------------------------------------------------------------------------

model Recipe {
  id           String     @id @default(cuid())
  title        String
  description  String?
  instructions String?    @db.Text
  visibility   Visibility @default(PRIVATE)
  authorId     String
  author       User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  images      RecipeImage[]
  ingredients RecipeIngredient[]
  tags        RecipeTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([title])
}

// Ordered gallery of images for a recipe. The lowest `position` is the hero
// image shown on cards and at the top of the recipe page.
model RecipeImage {
  id       String @id @default(cuid())
  recipeId String
  path     String
  position Int

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

// `name` is the English canonical label (the stable identity). Localized
// surface forms (e.g. German "Zwiebel") live in IngredientName and all point
// back here, so one entity unifies every language.
model Ingredient {
  id      String             @id @default(cuid())
  name    String             @unique
  names   IngredientName[]
  recipes RecipeIngredient[]
}

// A localized/alternate surface form for an ingredient. `normalized` is the
// lowercased lookup key and is globally unique: a given surface string maps to
// exactly one ingredient.
model IngredientName {
  id           String @id @default(cuid())
  ingredientId String
  name         String
  normalized   String @unique
  locale       String

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([ingredientId])
}

model Tag {
  id        String           @id @default(cuid())
  name      String           @unique
  names     TagName[]
  recipes   RecipeTag[]
  heartedBy UserHeartedTag[]
}

// Localized/alternate surface form for a tag (see IngredientName).
model TagName {
  id         String @id @default(cuid())
  tagId      String
  name       String
  normalized String @unique
  locale     String

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@index([tagId])
}

model RecipeIngredient {
  recipeId     String
  ingredientId String
  // The exact surface form typed on this recipe (e.g. "Zwiebel"). Falls back to
  // the ingredient's canonical English `name` when null.
  displayName  String?
  quantity     Float?
  unit         String?

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([recipeId, ingredientId])
  @@index([ingredientId])
}

model RecipeTag {
  recipeId    String
  tagId       String
  // The exact surface form typed on this recipe; falls back to the tag's
  // canonical English `name` when null.
  displayName String?

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([recipeId, tagId])
  @@index([tagId])
}

model UserHeartedTag {
  userId String
  tagId  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([userId, tagId])
  @@index([tagId])
}
