# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# For local `docker compose`, the host is the `db` service name.
DATABASE_URL="postgresql://recipe:recipe@localhost:5432/recipe?schema=public"

# Auth.js / NextAuth secret. Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# Public base URL of the app (used by Auth.js for callbacks).
AUTH_URL="http://localhost:3000"
# Legacy alias still read by some libraries; keep in sync with AUTH_URL.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Google OAuth credentials (Google Cloud Console > Credentials > OAuth client).
# Authorized redirect URI: <AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Variables consumed by docker-compose for the `db` service ----
POSTGRES_USER="recipe"
POSTGRES_PASSWORD="recipe"
POSTGRES_DB="recipe"
