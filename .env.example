# Copy to `.env` and fill in. `.env` is git-ignored.
#
# This single file is read by BOTH local dev (`npm run dev`) and the production
# docker-compose stack. For the container, docker-compose overrides DATABASE_URL
# (and uses AUTH_URL), so the localhost defaults below are for local dev.

# ---------------------------------------------------------------------------
# Auth (required everywhere)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public URL of the app.
#   local dev:   http://localhost:3000
#   production:  https://recipes.example.com
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth client (Google Cloud Console -> Credentials -> Web application).
# Authorized redirect URI: <AUTH_URL>/api/auth/callback/google
# Read at runtime — never baked into the image.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional access control: comma-separated emails allowed to sign in.
# Empty = anyone who passes Google sign-in. Set your email to lock it to you.
AUTH_ALLOWED_EMAILS=""

# Bootstrap admins: comma-separated emails promoted to ADMIN on sign-in. Set
# this to your own email to grant yourself admin the first time you sign in;
# from there you can promote/demote others in-app (Account -> Manage users).
# Removing an email here does NOT demote — do that from the admin page.
AUTH_ADMIN_EMAILS=""

# ---------------------------------------------------------------------------
# Local development database (used by `npm run dev`)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://recipe:recipe@localhost:5432/recipe?schema=public"

# ---------------------------------------------------------------------------
# Production docker-compose only (ignored by `npm run dev`)
# ---------------------------------------------------------------------------
# Image to run: ghcr.io/<owner>/recipe-app:<tag>. GHCR_OWNER is your GitHub
# username/org (lowercase); the repo must be named `recipe-app` to match CI.
GHCR_OWNER="your-github-username"
IMAGE_TAG="latest"

# Host directory for persistent data (Postgres data + uploaded images).
DATA_DIR="/mnt/user/appdata/recipe-app"

# Postgres credentials (compose builds the container's DATABASE_URL from these).
POSTGRES_USER="recipe"
POSTGRES_PASSWORD="recipe"
POSTGRES_DB="recipe"
